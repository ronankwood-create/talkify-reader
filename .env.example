# Talkify needs none of these. With nothing set it is a plain offline reader.
#
# Talkify reads these from the environment; it does not load this file on its
# own. Set them in your shell before starting it, for example in PowerShell:
#
#     $env:GEMINI_API_KEY = "your-key-here"
#     python talkify.py
#
# Each API key can instead go in config.json (gitignored) under the lowercase
# name, e.g. {"gemini_api_key": "your-key-here"}. config.json wins if both are set.

# --- Explain panel: bring your own key (optional) ---------------------------
# With a key set, highlighted passages are sent to that provider to explain.
# The first one found is used, in this order. Leave all blank to use local
# Ollama instead, or to turn the Explain panel off entirely.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Force one provider instead of the order above: gemini, anthropic, openai or ollama
TALKIFY_AI_PROVIDER=

# --- Explain panel: local model (optional) ----------------------------------
# Where Ollama is listening. Default: http://localhost:11434
# The model is set in config.json as "ollama_model" (default: llama3.2).
OLLAMA_HOST=

# --- Paths (optional) -------------------------------------------------------
# Where chapter MP3 exports go. Point it at a phone-synced folder
# (Google Drive, OneDrive, Dropbox) to get audio onto your phone.
TALKIFY_EXPORT_DIR=
# Where the library database and imported documents live. Default: ./library
TALKIFY_LIBRARY_DIR=

# --- Voice engine (optional) ------------------------------------------------
# pytorch (default) or onnx. onnx needs the two files in kokoro_assets/,
# see README.md.
TALKIFY_KOKORO_BACKEND=
